"""
fetch_news.py

Fetches the latest news using NewsAPI.
"""

import requests

from config import NEWS_API_KEY
from news.news_sources import COUNTRY, PAGE_SIZE
from news.clean_news import clean_articles


NEWS_API_URL = "https://newsapi.org/v2/top-headlines"


def fetch_latest_news():
    """
    Fetches the latest technology headlines.

    Returns:
        list
    """

    params = {
        "country": COUNTRY,
        "category": "technology",
        "pageSize": PAGE_SIZE,
        "apiKey": NEWS_API_KEY
    }

    try:

        response = requests.get(
            NEWS_API_URL,
            params=params,
            timeout=20
        )

        response.raise_for_status()

        data = response.json()

        articles = data.get("articles", [])

        return clean_articles(articles)

    except requests.exceptions.RequestException as error:

        print(f"News API Error: {error}")

        return []
